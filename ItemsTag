PlayerEvents.tick(event => {
    const player = event.player
    if (!player.isPlayer()) return
    const mainhand = player.mainHandItem//定义玩家主手物品

    if (mainhand.hasTag('forge:tools/bows') ) {//通过主手是否含有某种标签，来为玩家后续增加属性
        player.modifyAttribute('celestial_core:arrow_speed', 'toolbow_speed', 0.2, "multiply_base")
        player.modifyAttribute('quality_equipment:projectile_damage', 'tool/bow_damage', 0.5, "multiply_base")
        player.modifyAttribute('attributeslib:arrow_damage', 'tool/bow', 0.5, 'multiply_base')
    }
    else {//注意，玩家增加属性后，会出现，即使主手不是有特定标签，依然会有效果，为了解决这个问题，需要在玩家主手不是特定物品时，移除玩家增加的属性即可
        player.removeAttribute('celestial_core:arrow_speed', 'toolbow_speed')
        player.removeAttribute('quality_equipment:projectile_damage', 'tool/bow_damage')
        player.removeAttribute('attributeslib:arrow_damage', 'tool/bow')
    }
